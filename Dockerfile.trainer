# The retraining workflow's image (deploy/argo): harvest, train in PyTorch (CPU), gate, publish.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[train,gcp]'
COPY config ./config
COPY scripts ./scripts
COPY data ./data
COPY models ./models
ENV PYTHONUNBUFFERED=1 SCOUT_HOME=/app
